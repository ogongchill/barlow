{
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$CLAUDE_PROJECT_DIR\"/.claude/hooks/post-write.sh"
          }
        ]
      }
    ]
  },
  "permissions": {
    "allow": [
      "Bash(git status*)",
      "Bash(git branch*)",
      "Bash(git log*)",
      "Bash(git diff*)",
      "Bash(git checkout*)",
      "Bash(git pull*)",
      "Bash(git add*)",
      "Bash(git commit*)",
      "Bash(git push*)",
      "Bash(gh issue view*)",
      "Bash(gh pr create*)",
      "Bash(./gradlew*)",
      "Read(*)",
      "Glob(*)",
      "Grep(*)",
      "Write(**)",
      "Edit(**)",
      "Write(.claude/workspace/**)",
      "Edit(/Users/jochan-u/.claude/**)",
      "Agent(*)"
    ]
  }
}